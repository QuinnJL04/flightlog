// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  // scrypt hash of the user's password, in the format produced by
  // src/lib/password.ts. Nullable because the seeded user predates passwords —
  // a null hash means "this account cannot be signed into", never "any
  // password works". verifyPassword() enforces that.
  passwordHash String?

  trips    Trip[]
  sessions Session[]
}

// One row per active login. Deleting a row logs that device out immediately,
// which is the main thing you get from database sessions over a signed cookie:
// revocation. A stateless JWT stays valid until it expires no matter what.
model Session {
  id String @id @default(cuid())

  // SHA-256 of the token we put in the cookie — never the token itself. If
  // this table leaks, the hashes are useless for logging in, because the
  // lookup hashes the incoming cookie and compares. Same reasoning as
  // passwords, minus the need for a slow hash: the token is 256 random bits,
  // so there is no dictionary to attack.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Trip {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flights Flight[]
}

model Airline {
  id       String  @id @default(cuid())
  name     String  @unique
  iataCode String? @unique

  flights Flight[]
}

model Flight {
  id            String   @id @default(cuid())
  origin        String
  destination   String
  departureDate DateTime
  createdAt     DateTime @default(now())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  airlineId String?
  airline   Airline? @relation(fields: [airlineId], references: [id])
}
